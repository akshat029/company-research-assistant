# ============================================================
# Company Research Assistant - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys

# ----- LLM Configuration -----
# Choose your LLM provider: openai or groq
LLM_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Groq - FREE alternative (https://console.groq.com)
# Set LLM_PROVIDER=groq and fill this key for free usage
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ----- Tavily Search API (https://app.tavily.com) -----
# Free tier: 1000 searches/month
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ----- Research Settings -----
MAX_SEARCH_RESULTS=8
RESEARCH_TIMEOUT_SECONDS=120

# ----- Cache Settings -----
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ----- App Settings -----
DEBUG=false
