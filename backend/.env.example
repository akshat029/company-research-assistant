# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#
#   Windows :  copy .env.example .env
#   macOS   :  cp .env.example .env
#
# WARNING: the placeholders below are NOT valid keys. Leaving them in place
# causes a 401 "Incorrect API key provided" on the first research query.
# .env is gitignored, so `git pull` never overwrites your real keys.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Tavily powers every web search and news lookup. https://app.tavily.com
TAVILY_API_KEY=tvly-REPLACE_ME

# Which LLM runs the agent: "openai" or "groq".
LLM_PROVIDER=groq

# Only the key for your chosen LLM_PROVIDER is required; the other may stay
# blank. Provider modules are imported lazily, so an unused provider does not
# even need its package installed.
OPENAI_API_KEY=
GROQ_API_KEY=gsk_REPLACE_ME


# --- Models ---------------------------------------------------------------

OPENAI_MODEL=gpt-4o

# Stage 1: the tool-calling loop. Use the 70b model. Counter-intuitively the 8b
# model has a LOWER free-tier budget (6,000 tokens/min vs 12,000), so it
# rate-limits sooner, not later. Dependable function calling matters more here
# than raw reasoning, which is why this is not the largest model on offer.
GROQ_MODEL=llama-3.3-70b-versatile

# Stages 2 and 4: extraction and analysis. Neither carries tool history and both
# reason over text that has already been retrieved, so they can afford a
# stronger model. gpt-oss-120b is the strongest free-tier reasoning model on
# Groq and supports structured output. Leave blank to fall back to GROQ_MODEL.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b

# Only read when LLM_PROVIDER=openai. Blank reuses OPENAI_MODEL.
OPENAI_ANALYSIS_MODEL=

# 0.0 keeps extraction deterministic.
LLM_TEMPERATURE=0.0

# Output budget for the agent's reasoning turns (stage 1: gathering).
LLM_MAX_TOKENS=2048

# Output budget for the extraction turn (stage 2: JSON assembly). Keep this
# generous: too small truncates the JSON mid-string and the UI falls back to
# "Research completed but JSON parsing failed."
EXTRACTION_MAX_TOKENS=4096


# --- Analysis (stage 4) ---------------------------------------------------

# The analyst stage turns the verified fact sheet into a consultant-style read:
# thesis, competitive position, moat, ranked risks, non-obvious observations and
# the questions worth asking. It runs AFTER link verification, so it can only
# reason about facts that were actually retrieved, and every point it makes
# cites the sources it came from.
#
# Set to False to switch it off for the whole server. The UI toggle can then
# never turn it back on.
ENABLE_ANALYSIS=True

# Judgement benefits from a little sampling. Everything else stays at 0.0.
ANALYSIS_TEMPERATURE=0.3

# Output budget for the analyst turn.
ANALYSIS_MAX_TOKENS=4096

# low | medium | high. Only gpt-oss style reasoning models honour this. It is
# dropped automatically for models and SDK versions that reject it, so an
# unsupported value costs a retry rather than the whole stage.
ANALYSIS_REASONING_EFFORT=medium

# How many verified sources the analyst is shown. Each one costs prompt tokens,
# and past roughly 15 the marginal source stops changing the conclusions.
ANALYSIS_MAX_EVIDENCE=14


# --- Retrieval and grounding ----------------------------------------------

# How many results Tavily returns per search. All of them are recorded as
# sources even when only a few are shown to the model.
MAX_SEARCH_RESULTS=8

# How many of those are actually pasted into the prompt. Keeping this below
# MAX_SEARCH_RESULTS is the main lever against Groq's per-minute token cap:
# the source collector still sees everything, the prompt does not.
SEARCH_RESULTS_IN_PROMPT=4

# Characters of each result's snippet shown to the model.
SEARCH_SNIPPET_CHARS=350

# News older than this many days is filtered out of the news search. This is
# what stops 2021-era headlines being presented as current.
NEWS_RECENCY_DAYS=180

# Upper bound on retained source records per research run.
MAX_SOURCES=25

# Page-scraping budget.
MAX_SCRAPE_CHARS=4000
MAX_SCRAPE_PAGES=3


# --- Agent budget ---------------------------------------------------------

# Floor for the LangGraph recursion limit. The effective limit is raised
# automatically per depth (quick/standard/deep), so the agent can never be told
# "make N searches" while being cut off after fewer total steps.
AGENT_RECURSION_LIMIT=8

# Hard ceiling on a single research request.
RESEARCH_TIMEOUT_SECONDS=120


# --- Caching --------------------------------------------------------------

ENABLE_CACHE=True
CACHE_TTL_SECONDS=3600


# --- App ------------------------------------------------------------------

APP_NAME=Company Research Assistant
APP_VERSION=1.2.0
DEBUG=False

# CORS_ORIGINS is parsed as JSON because it is a list. If you set it, it must
# look exactly like the line below or startup will fail. Leave it commented to
# use the built-in localhost defaults.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
