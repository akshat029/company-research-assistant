# ============================================================
# Company Research Assistant - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
#
#   macOS / Linux:  cp .env.example .env
#   Windows (CMD):  copy .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#
# WARNING: copying over an existing .env will overwrite your real keys
# with the placeholders below. Only copy once.

# ----- LLM Configuration -----
# Choose your LLM provider: groq (free) or openai (paid)
# Defaults to groq so a fresh clone works without a paid account.
LLM_PROVIDER=groq

# Groq - FREE (https://console.groq.com)
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI - paid (https://platform.openai.com/api-keys)
# Only needed when LLM_PROVIDER=openai. Leave commented out otherwise:
# an unresolved placeholder here causes a 401 on the first request.
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# Max tokens the model may generate per call.
# Groq counts reserved output tokens against your tokens-per-minute quota
# (free tier: 12,000 TPM for llama-3.3-70b-versatile). Raising this makes
# HTTP 413 "Request too large" more likely.
LLM_MAX_TOKENS=2048

# ----- Tavily Search API (https://app.tavily.com) -----
# Free tier: 1000 searches/month
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ----- Research Settings -----
MAX_SEARCH_RESULTS=8
RESEARCH_TIMEOUT_SECONDS=120

# ----- Cache Settings -----
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ----- App Settings -----
DEBUG=false
