# ============================================================
# Company Research Assistant - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
#
#   macOS / Linux:  cp .env.example .env
#   Windows (CMD):  copy .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#
# WARNING: copying over an existing .env will overwrite your real keys
# with the placeholders below. Only copy once.

# ----- LLM Configuration -----
# Choose your LLM provider: groq (free) or openai (paid)
# Defaults to groq so a fresh clone works without a paid account.
LLM_PROVIDER=groq

# Groq - FREE (https://console.groq.com)
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI - paid (https://platform.openai.com/api-keys)
# Only needed when LLM_PROVIDER=openai. Leave commented out otherwise:
# an unresolved placeholder here causes a 401 on the first request.
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# ----- Token Budgets -----
# Research is done in two stages, each with its own output budget.
#
# Stage 1 (research): the agent calls search tools and writes a plain-text
# brief. Reserved output tokens count against Groq's tokens-per-minute quota
# (free tier: 12,000 TPM), and every ReAct turn resends the full history,
# so keep this modest.
LLM_MAX_TOKENS=2048
#
# Stage 2 (extraction): one tool-free call that fills the result schema.
# It carries no tool history, so it can afford a bigger budget - and it needs
# one, or the structured output gets truncated.
EXTRACTION_MAX_TOKENS=4096

# Max ReAct turns before LangGraph gives up. Each turn resends the whole
# message history, so raising this increases token usage fast. Lower it to 4
# if you keep hitting HTTP 413.
AGENT_RECURSION_LIMIT=8

# ----- Tavily Search API (https://app.tavily.com) -----
# Free tier: 1000 searches/month
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ----- Research Settings -----
# Results per search. Lower this first if you hit rate limits.
MAX_SEARCH_RESULTS=8
RESEARCH_TIMEOUT_SECONDS=120

# ----- Cache Settings -----
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ----- App Settings -----
DEBUG=false
